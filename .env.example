# Supabase: Project Settings > Database > Connection string > "Session pooler" (port 5432)
# (Transaction pooler / 6543 нь prepared statement-тэй зөрчилддөг тул ашиглахгүй)
DATABASE_URI=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Дор хаяж 32 тэмдэгт: openssl rand -base64 48
# Supabase-ийн CA (Dashboard > Database > SSL). Сертификатын алдаа гарвал PEM-ийг энд (мөр бүрийн төгсгөлд \\n)
DATABASE_CA=
PAYLOAD_SECRET=
OTP_SECRET=
SERVER_URL=http://localhost:3000
# Үр дүн харуулахад шаардлагатай хамгийн цөөн үнэлэгч (доод хязгаар 2)
MIN_RATERS=2
# Production-д заавал. Dev-д хоосон бол код нь серверийн консолд хэвлэгдэнэ
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Багийн үнэлгээ <no-reply@example.edu.mn>"
